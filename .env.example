# Vyravo AI — environment variables
#
# Copy to `.env.local` for local development (never commit real secrets — the
# repo's .gitignore excludes every .env* file except this example).
# In production, set these in Vercel → Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# OpenAI (powers the website chatbot, Knowledge Base answers, AI proposals)
# ---------------------------------------------------------------------------
# REQUIRED for AI-powered chat. Server-side only — never exposed to the browser.
# Without it the chatbot degrades to the built-in deterministic engine.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. Default: gpt-4o-mini (cost-efficient, right-sized for website chat).
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional tuning.
# OPENAI_TIMEOUT_MS=20000
# OPENAI_MAX_RETRIES=1
# OPENAI_CHAT_MAX_TOKENS=700

# Optional. Force a provider: internal | openai | anthropic | gemini
# Unset = OpenAI when OPENAI_API_KEY exists, otherwise the internal engine.
# CHATBOT_PROVIDER=openai

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required for persistent conversations, lead storage, and the existing CRM
# features. The local fallback is only for a developer's local PostgreSQL.
DATABASE_URL=postgres://user:password@host:5432/database

# ---------------------------------------------------------------------------
# WhatsApp Business Platform — Meta Cloud API (server-side only)
# ---------------------------------------------------------------------------
# Required to receive and send real WhatsApp messages.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Optional but recommended: rejects signed events from another WABA.
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# A random value that you enter in Meta's webhook configuration exactly as-is.
META_WHATSAPP_VERIFY_TOKEN=
# Meta App Secret used to verify X-Hub-Signature-256 on every POST webhook.
META_WHATSAPP_APP_SECRET=

# Optional. Set this when Meta changes its Graph API version.
# META_GRAPH_API_VERSION=v23.0
# Local-only testing escape hatch; production should use the database (default).
# WHATSAPP_STORE=memory

# Public number used by the website click-to-chat link (digits with country code,
# no plus sign). This is not a secret. It defaults to the current Vyravo number.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919075707650

# ---------------------------------------------------------------------------
# CRM / integrations (all optional — each degrades gracefully when unset)
# ---------------------------------------------------------------------------
# HUBSPOT_ACCESS_TOKEN=
# CALENDLY_ACCESS_TOKEN=
# RESEND_API_KEY=
# EMAIL_AUTOMATION_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Knowledge Base embeddings (local | openai | cohere | google)
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------------------
# Admin / auth
# ---------------------------------------------------------------------------
# ADMIN_API_KEY=
