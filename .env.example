# Vyravo AI — environment variables
#
# Copy to `.env.local` for local development (never commit real secrets — the
# repo's .gitignore excludes every .env* file except this example).
# In production, set these in Vercel → Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# OpenAI (powers the website chatbot, Knowledge Base answers, AI proposals)
# ---------------------------------------------------------------------------
# REQUIRED for AI-powered chat. Server-side only — never exposed to the browser.
# Without it the chatbot degrades to the built-in deterministic engine.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. Default: gpt-4o-mini (cost-efficient, right-sized for website chat).
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional tuning.
# OPENAI_TIMEOUT_MS=20000
# OPENAI_MAX_RETRIES=1
# OPENAI_CHAT_MAX_TOKENS=700

# Optional. Force a provider: internal | openai | anthropic | gemini
# Unset = OpenAI when OPENAI_API_KEY exists, otherwise the internal engine.
# CHATBOT_PROVIDER=openai

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/database

# ---------------------------------------------------------------------------
# CRM / integrations (all optional — each degrades gracefully when unset)
# ---------------------------------------------------------------------------
# HUBSPOT_ACCESS_TOKEN=
# CALENDLY_ACCESS_TOKEN=
# RESEND_API_KEY=
# EMAIL_AUTOMATION_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Knowledge Base embeddings (local | openai | cohere | google)
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------------------
# Admin / auth
# ---------------------------------------------------------------------------
# ADMIN_API_KEY=
